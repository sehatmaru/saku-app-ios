    },
    "%@ diarsipkan": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ archived"
          }
        }
      }
    },
    "%@ dilewati karena belum lengkap. Tetap ada di sini untuk dicek.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ skipped because incomplete. They stay here to check."
          }
        }
      }
    },
    "%@ dipakai dari %@ sampai %@ (%lld periode). Mulai %@ kembali ke %@. Budget awalmu tidak berubah.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is used from %@ to %@ (%lld periods). From %@ it goes back to %@. Your original budget doesn't change."
          }
        }
      }
    },
    "%@ diperpanjang 3 hari lagi sebesar %@. Batalkan sebelum itu kalau sudah tidak dipakai.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ renews in 3 days for %@. Cancel before then if you no longer use it."
          }
        }
      }
    },
    "%@ disembunyikan": {
      "localizations": {
