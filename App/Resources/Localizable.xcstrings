    "%@ akan dihapus dari daftar dompet.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ will be removed from your wallet list."
          }
        }
      }
    },
    "%@ akan kembali ke %@ dan keluar dari %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ will go back to %2$@ and leave %3$@."
          }
        }
      }
    },
    "%@ akan kembali ke %@ dan tagihan %@ naik lagi.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ will go back to %2$@ and the %3$@ bill goes up again."
          }
        }
      }
    },
    "%@ belum tercatat lunas. Sudah kamu bayar?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ isn't recorded as paid. Did you pay it?"
          }
        }
      }
    },
    "%@ dan budget %@ bertambah %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ and the %2$@ budget goes up by %3$@."
          }
        }
      }
    },
    "%@ dan saldonya (%@) akan keluar dari total saldo.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ and its balance (%@) will leave your total balance."
          }
        }
      }
    },
    "%@ dan utang %@ akan dihapus dari daftar dan total.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ and its %@ debt will be removed from the list and totals."
          }
        }
      }
    },
    "%@ dari %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ of %@"
