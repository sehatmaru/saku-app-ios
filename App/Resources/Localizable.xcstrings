  "strings": {
    " bisa dipakai hari ini.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " safe to spend today."
          }
        }
      }
    },
    " dan ": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " and "
          }
        }
      }
    },
    " untuk %lld hari tersisa.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " for the %lld days left."
          }
        }
      }
    },
    " untuk +%lld poin": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " for +%lld points"
          }
        }
      }
    },
    " · hari ke-%lld dari %lld": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " · day %lld of %lld"
          }
        }
      }
    },
    " · pilih dompet lain": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " · choose another wallet"
          }
        }
      }
    },
    "\"Simpan draf\" sedang diisi, jadi notifikasi dengan judul lain tidak dibuat draf.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Save as draft\" is filled in, so notifications with other titles don't become drafts."
          }
        }
      }
    },
    "%@ akan dihapus dari daftar dompet.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ will be removed from your wallet list."
          }
        }
      }
    },
    "%@ akan kembali ke %@ dan keluar dari %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ will go back to %2$@ and leave %3$@."
          }
        }
      }
    },
    "%@ akan kembali ke %@ dan tagihan %@ naik lagi.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ will go back to %2$@ and the %3$@ bill goes up again."
          }
        }
      }
    },
    "%@ belum tercatat lunas. Sudah kamu bayar?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ isn't recorded as paid. Did you pay it?"
          }
        }
      }
    },
    "%@ belum terisi": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is empty"
          }
        }
      }
    },
    "%@ dan budget %@ bertambah %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ and the %2$@ budget goes up by %3$@."
          }
        }
      }
    },
    "%@ dan saldonya (%@) akan keluar dari total saldo.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ and its balance (%@) will leave your total balance."
          }
        }
      }
    },
    "%@ dan utang %@ akan dihapus dari daftar dan total.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ and its %@ debt will be removed from the list and totals."
          }
        }
      }
    },
    "%@ dari %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ of %@"
          }
        }
      }
    },
    "%@ dari dompet investasi": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ from investment wallets"
          }
        }
      }
    },
    "%@ dengan limit Rp%@ siap dipakai.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ with a Rp%@ limit is ready to use."
          }
        }
      }
    },
    "%@ dengan saldo Rp%@ sudah masuk ke total saldo.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ with a Rp%@ balance is now part of your total balance."
