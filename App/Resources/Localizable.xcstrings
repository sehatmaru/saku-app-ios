    "\"Simpan draf\" sedang diisi, jadi notifikasi dengan judul lain tidak dibuat draf.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Save as draft\" is filled in, so notifications with other titles don't become drafts."
          }
        }
      }
    },
    "%@ %@ %lld%% dari rata-rata 3 periode.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ %lld%% from the 3-period average."
          }
        }
      }
    },
    "%@ akan dihapus dari daftar dompet.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ will be removed from your wallet list."
          }
        }
      }
    },
    "%@ akan kembali ke %@ dan keluar dari %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ will go back to %2$@ and leave %3$@."
          }
        }
      }
    },
    "%@ akan kembali ke %@ dan tagihan %@ naik lagi.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ will go back to %2$@ and the %3$@ bill goes up again."
          }
        }
      }
    },
    "%@ belum tercatat lunas. Sudah kamu bayar?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ isn't recorded as paid. Did you pay it?"
